# Copy to .env and fill in. Never commit .env.

# Bot token from https://discord.com/developers/applications (Bot tab)
DISCORD_TOKEN=

# Hardcover API key with the read:catalog scope (https://hardcover.app/account/api)
HARDCOVER_TOKEN=

# Optional: URL pinged every 5 minutes while the bot is connected (e.g. healthchecks.io)
HEARTBEAT_URL=

# Optional: Discord user ID to DM about errors. Defaults to the bot application's owner.
OWNER_ID=

# Optional: link to the bot's support server, shown at the end of /help.
SUPPORT_URL=

# Optional: record which books are asked for in a SQLite file (see docs/HOW_IT_WORKS.md).
# Leave both empty to record nothing. The salt must be a long random secret (e.g.
# `openssl rand -hex 32`) and must never change, or people's hashes stop matching.
USAGE_DB=
USAGE_SALT=
